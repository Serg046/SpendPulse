@rendermode InteractiveWebAssembly
@implements IDisposable
@using SpendPulse.Client.Repositories
@using SpendPulse.Client.Services
@inject ITransactionRepository TransactionRepository
@inject IMerchantMappingRepository MerchantMappingRepository
@inject IMerchantNameExclusionRepository MerchantNameExclusionRepository
@inject MerchantMappingState MerchantMappingState

<div class="nav-menu-root">
    <div class="top-row">
        <div class="top-row__brand">
            <a class="navbar-brand" href="">SpendPulse</a>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav-menu">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> Transactions
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="trends">
                    <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> Trends
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="merchants">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Merchants
                    @if (_conflictingCount > 0)
                    {
                        <span class="nav-item__badge">@_conflictingCount</span>
                    }
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="groups">
                    <span class="bi bi-collection-nav-menu" aria-hidden="true"></span> Groups
                </NavLink>
            </div>
        </nav>
    </div>
</div>

@code {
    [PersistentState]
    public int? ConflictingCount { get; set; }

    private int _conflictingCount;

    protected override async Task OnInitializedAsync()
    {
        MerchantMappingState.Changed += OnMappingChanged;

        if (ConflictingCount is not null)
        {
            _conflictingCount = ConflictingCount.Value;
            return;
        }

        await Load();
    }

    private async Task Load()
    {
        var merchantNames = await TransactionRepository.GetDistinctMerchantNames();
        var mappings = await MerchantMappingRepository.GetAll();
        var exclusions = await MerchantNameExclusionRepository.GetAll();
        var mappedNames = mappings.Select(m => m.MappedFrom).ToHashSet();

        var similarGroups = MerchantSimilarityMatcher.ComputeSimilarGroups(merchantNames, mappedNames, exclusions);

        ConflictingCount = similarGroups.Count;
        _conflictingCount = ConflictingCount.Value;
    }

    private async void OnMappingChanged()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MerchantMappingState.Changed -= OnMappingChanged;
    }
}
