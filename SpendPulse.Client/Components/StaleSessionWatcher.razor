@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_isReloading)
{
    <div class="stale-session-overlay">
        <div class="stale-session-overlay__spinner"></div>
        <span>Refreshing…</span>
    </div>
}

@code {
    private static readonly TimeSpan StaleAfter = TimeSpan.FromMinutes(5);

    private const string VisibilityModuleSource = """
        export function watchVisibility(dotnetHelper) {
            if (!window.matchMedia('(max-width: 640px)').matches) {
                return;
            }
            document.addEventListener('visibilitychange', () => {
                dotnetHelper.invokeMethodAsync('OnVisibilityChanged', document.visibilityState);
            });
        }

        export function reloadAfterPaint() {
            // Double rAF guarantees the overlay has actually been painted
            // before we navigate away, so the reload reads as intentional
            // instead of a jarring flash of the old content.
            requestAnimationFrame(() => requestAnimationFrame(() => location.reload()));
        }
        """;

    private IJSObjectReference? _module;
    private DotNetObjectReference<StaleSessionWatcher>? _selfReference;
    private DateTime? _hiddenAt;
    private bool _isReloading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var moduleUrl = "data:text/javascript;charset=utf-8," + Uri.EscapeDataString(VisibilityModuleSource);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", moduleUrl);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("watchVisibility", _selfReference);
    }

    [JSInvokable]
    public async Task OnVisibilityChanged(string visibilityState)
    {
        if (visibilityState == "hidden")
        {
            _hiddenAt = DateTime.UtcNow;
            return;
        }

        if (_hiddenAt is null)
        {
            return;
        }

        var hiddenFor = DateTime.UtcNow - _hiddenAt.Value;
        _hiddenAt = null;

        if (hiddenFor >= StaleAfter && _module is not null)
        {
            _isReloading = true;
            StateHasChanged();
            await Task.Yield();
            await _module.InvokeVoidAsync("reloadAfterPaint");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _selfReference?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already tearing down - nothing to clean up.
            }
        }
    }
}
