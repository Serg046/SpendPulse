@rendermode InteractiveWebAssembly
@using SpendPulse.Client.Models
@using SpendPulse.Client.Repositories
@using SpendPulse.Client.Services
@using Microsoft.AspNetCore.Components
@inject ISyncStatusRepository SyncStatusRepository
@inject SyncStatusState SyncStatusState
@inject NavigationManager NavigationManager

<div class="sync-status">
    <StatusBar/>
    <span class="sync-status__text sync-status__username">@Username</span>
    <div class="sync-status__row">
        @if (IsAdmin)
        {
            <button class="sync-status__button @(IsTokenExpiringSoon ? "sync-status__button--warning" : "")" @onclick="() => RefreshToken()" aria-label="Refresh Enable Banking token" disabled="@SyncStatusState.IsSyncing">
                <svg class="sync-status__icon @(_isRefreshingToken ? "sync-status__icon--pulsing" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 20 7 4 7"/>
                    <line x1="6" y1="11" x2="6" y2="18"/>
                    <line x1="10" y1="11" x2="10" y2="18"/>
                    <line x1="14" y1="11" x2="14" y2="18"/>
                    <line x1="18" y1="11" x2="18" y2="18"/>
                    <line x1="3" y1="22" x2="21" y2="22"/>
                </svg>
            </button>
        }
        <button class="sync-status__button" @onclick="Sync" aria-label="Sync" disabled="@(!IsAdmin || SyncStatusState.IsSyncing)">
            <svg class="sync-status__icon @(_isSyncing ? "sync-status__icon--spinning" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 4v6h-6"/>
                <path d="M1 20v-6h6"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/>
                <path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/>
            </svg>
        </button>
        <span class="sync-status__text sync-status__text--clickable" @onclick="OpenHistoryModal">@(LastDataUpdate is null ? "" : AppTimeZone.ToDisplayTime(LastDataUpdate.Value).ToString("dd.MM.yyyy HH:mm"))</span>
    </div>
</div>

@if (_showHistoryModal)
{
    <div class="modal-backdrop" @onclick="CloseHistoryModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-box__header">
                <span>Sync history</span>
                <button class="modal-box__close" @onclick="CloseHistoryModal" aria-label="Close">&times;</button>
            </div>

            @if (_loadingHistory)
            {
                <p class="sync-history__loading">Loading...</p>
            }
            else
            {
                <div class="sync-history__list">
                    @foreach (var entry in _historyEntries)
                    {
                        <div class="sync-history__row @(entry.Success ? "" : "sync-history__row--failed")" @onclick="() => ToggleError(entry)">
                            <span class="sync-history__time">@AppTimeZone.ToDisplayTime(entry.StartedAt).ToString("dd.MM.yyyy HH:mm")</span>
                            <span class="sync-history__status">@(entry.Success ? "Success" : "Failed")</span>
                            <span class="sync-history__count">@(entry.Success ? $"+{entry.NewTransactionCount}" : "")</span>
                        </div>
                        @if (!entry.Success && !string.IsNullOrEmpty(entry.ErrorMessage) && ReferenceEquals(_expandedEntry, entry))
                        {
                            <div class="sync-history__error">@entry.ErrorMessage</div>
                        }
                    }
                    @if (_historyEntries.Count == 0)
                    {
                        <span class="sync-history__empty">No syncs recorded yet.</span>
                    }
                </div>

                <div class="sync-history__pager">
                    <button class="sync-history__pager-btn" @onclick="PreviousHistoryPage" disabled="@(_historyPage == 0)" aria-label="Previous page">&#8249;</button>
                    <span class="sync-history__pager-label">Page @(_historyPage + 1) of @TotalHistoryPages</span>
                    <button class="sync-history__pager-btn" @onclick="NextHistoryPage" disabled="@(!HasNextHistoryPage)" aria-label="Next page">&#8250;</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [PersistentState]
    public string? Username { get; set; }

    [PersistentState]
    public bool IsAdmin { get; set; }

    [PersistentState]
    public DateTime? LastDataUpdate { get; set; }

    [PersistentState]
    public bool IsTokenExpiringSoon { get; set; }

    private const int HistoryPageSize = 10;

    private bool _isSyncing;
    private bool _isRefreshingToken;
    private bool _showHistoryModal;
    private bool _loadingHistory;
    private int _historyPage;
    private int _historyTotalCount;
    private List<SyncHistoryEntry> _historyEntries = [];
    private SyncHistoryEntry? _expandedEntry;

    private int TotalHistoryPages => Math.Max(1, (int)Math.Ceiling(_historyTotalCount / (double)HistoryPageSize));
    private bool HasNextHistoryPage => (_historyPage + 1) * HistoryPageSize < _historyTotalCount;

    protected override async Task OnInitializedAsync()
    {
        if (LastDataUpdate is null)
        {
            await Load();
        }

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var code = GetQueryParam("code");
        if (code is not null)
        {
            NavigationManager.NavigateTo(NavigationManager.Uri.Split('?')[0], replace: true);
            await RefreshToken(code);
        }
    }

    private string? GetQueryParam(string name)
    {
        var query = new Uri(NavigationManager.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && Uri.UnescapeDataString(parts[0]) == name)
            {
                return Uri.UnescapeDataString(parts[1]);
            }
        }

        return null;
    }

    private async Task Load()
    {
        Username = await SyncStatusRepository.GetUsername();
        IsAdmin = await SyncStatusRepository.IsAdmin();
        LastDataUpdate = await SyncStatusRepository.GetLastDataUpdate();
        IsTokenExpiringSoon = await SyncStatusRepository.IsTokenExpiringSoon();
    }

    private async Task Sync()
    {
        if (!IsAdmin)
        {
            return;
        }

        SyncStatusState.IsSyncing = true;
        _isSyncing = true;
        StateHasChanged();

        try
        {
            LastDataUpdate = await SyncStatusRepository.Sync();
            SyncStatusState.NotifySyncCompleted();
        }
        finally
        {
            SyncStatusState.IsSyncing = false;
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task RefreshToken(string? code = null)
    {
        if (!IsAdmin)
        {
            return;
        }

        SyncStatusState.IsSyncing = true;
        _isRefreshingToken = true;
        StateHasChanged();

        string? authUrl;
        try
        {
            authUrl = await SyncStatusRepository.RefreshToken(code);
        }
        finally
        {
            SyncStatusState.IsSyncing = false;
            _isRefreshingToken = false;
            StateHasChanged();
        }

        if (authUrl is not null)
        {
            NavigationManager.NavigateTo(authUrl, forceLoad: true);
        }
        else if (code is not null)
        {
            IsTokenExpiringSoon = false;
            await Sync();
        }
    }

    private async Task OpenHistoryModal()
    {
        _showHistoryModal = true;
        _historyPage = 0;
        await LoadHistoryPage();
    }

    private void CloseHistoryModal()
    {
        _showHistoryModal = false;
    }

    private async Task LoadHistoryPage()
    {
        _loadingHistory = true;
        _expandedEntry = null;
        StateHasChanged();

        try
        {
            var page = await SyncStatusRepository.GetSyncHistory(_historyPage, HistoryPageSize);
            _historyEntries = page.Entries;
            _historyTotalCount = page.TotalCount;
        }
        finally
        {
            _loadingHistory = false;
            StateHasChanged();
        }
    }

    private void ToggleError(SyncHistoryEntry entry)
    {
        if (entry.Success)
        {
            return;
        }

        _expandedEntry = ReferenceEquals(_expandedEntry, entry) ? null : entry;
    }

    private async Task PreviousHistoryPage()
    {
        if (_historyPage == 0)
        {
            return;
        }

        _historyPage--;
        await LoadHistoryPage();
    }

    private async Task NextHistoryPage()
    {
        if (!HasNextHistoryPage)
        {
            return;
        }

        _historyPage++;
        await LoadHistoryPage();
    }
}
